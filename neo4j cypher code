  {follower: 'u1', followee: 'u2', since: '2023-06-15'},
  {follower: 'u2', followee: 'u1', since: '2023-06-16'},
  {follower: 'u3', followee: 'u1', since: '2024-01-10'},
  {follower: 'u9', followee: 'u5', since: '2024-03-22'}
] AS row

MATCH (p1:Player {user_id: row.follower})
MATCH (p2:Player {user_id: row.followee})
MERGE (p1)-[r:FOLLOWS]->(p2)
SET r.since = date(row.since);

// Automatically find players with similar ELO scores and link them
MATCH (p1:Player), (p2:Player)
// Ensure we don't match a player to themselves, and prevent duplicate reverse edges
WHERE p1.user_id < p2.user_id 
  AND p1.sport = p2.sport
  // Calculate if ELO difference is less than or equal to 100
  AND abs(p1.elo_score - p2.elo_score) <= 100 
  
// Create an undirected relationship since similarity is mutual
MERGE (p1)-[r:SIMILAR_LEVEL]-(p2) 
SET r.elo_delta = abs(p1.elo_score - p2.elo_score),
    r.computed_at = datetime();
