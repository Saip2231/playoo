CREATE CONSTRAINT FOR (c:Court) REQUIRE c.court_id IS UNIQUE;
// Ensure TimeSlot slot_id is unique
CREATE CONSTRAINT FOR (t:TimeSlot) REQUIRE t.slot_id IS UNIQUE;

