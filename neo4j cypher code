UNWIND [
  {p1: 'u1', p2: 'u2', date: '2024-05-01', winner: 'u1', score: '21-18, 21-15', arena: 'a1'},
  {p1: 'u4', p2: 'u7', date: '2024-05-03', winner: 'u7', score: '15-21, 21-19, 21-17', arena: 'a4'},
  {p1: 'u14', p2: 'u5', date: '2024-05-05', winner: 'u5', score: '6-2, 6-4', arena: 'a1'}
] AS row

MATCH (p1:Player {user_id: row.p1})
MATCH (p2:Player {user_id: row.p2})
MERGE (p1)-[r:PLAYED_AGAINST {date: date(row.date)}]->(p2)
SET r.winner_id = row.winner, 
    r.score = row.score, 
    r.arena_id = row.arena;

UNWIND [
  {p1: 'u3', p2: 'u6', status: 'pending', created: '2024-05-09T08:30:00Z', slot: 'ts1'},
