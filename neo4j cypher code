  {p1: 'u8', p2: 'u10', status: 'declined', created: '2024-05-07T18:00:00Z', slot: 'ts7'}
] AS row

MATCH (p1:Player {user_id: row.p1})
MATCH (p2:Player {user_id: row.p2})
MERGE (p1)-[r:CHALLENGED {slot_id: row.slot}]->(p2)
SET r.status = row.status, 
    r.created_at = datetime(row.created);

