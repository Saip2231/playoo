CREATE TABLE users (
    id SERIAL PRIMARY KEY,
    email VARCHAR(150) UNIQUE NOT NULL,
    skill_tier INTEGER,
    sport VARCHAR(50),
    location VARCHAR(100)
);

-- 2. Arenas 
CREATE TABLE arenas (
    arenas_id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    address VARCHAR(200),
    lat FLOAT,
    lng FLOAT,
    sport_types TEXT[],
    amenities TEXT[]
);

-- 3. Courts 
CREATE TABLE courts (
    court_id SERIAL PRIMARY KEY,
    arenas_id INTEGER REFERENCES arenas(arenas_id) ON DELETE CASCADE,
    court_name VARCHAR(100) NOT NULL,
    surface_type VARCHAR(50),
    is_active BOOLEAN DEFAULT true
);

-- 4. Time Slots 
CREATE TABLE time_slots (
    timeslot_id SERIAL PRIMARY KEY,
    -- FIXED: Changed courts(id) to courts(court_id)
    court_id INTEGER REFERENCES courts(court_id) ON DELETE CASCADE, 
    starts_at TIMESTAMP WITH TIME ZONE NOT NULL,
    ends_at TIMESTAMP WITH TIME ZONE NOT NULL,
    status VARCHAR(50) DEFAULT 'available',
    price_cents INTEGER NOT NULL
);

-- 5. Bookings 
CREATE TABLE bookings (
    booking_id SERIAL PRIMARY KEY,
    -- FIXED: Changed time_slots(id) to time_slots(timeslot_id)
    slot_id INTEGER REFERENCES time_slots(timeslot_id) ON DELETE RESTRICT, 
    user_id INTEGER REFERENCES users(id) ON DELETE CASCADE,
    stripe_payment_id VARCHAR(100),
    status VARCHAR(50) DEFAULT 'pending',
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 6. Matches 
CREATE TABLE matches (
    id SERIAL PRIMARY KEY,
    -- FIXED: Changed bookings(id) to bookings(booking_id)
    booking_id INTEGER REFERENCES bookings(booking_id) ON DELETE CASCADE, 
    player_a_id INTEGER REFERENCES users(id) ON DELETE SET NULL,
    player_b_id INTEGER REFERENCES users(id) ON DELETE SET NULL,
    status VARCHAR(50) DEFAULT 'scheduled',
    score_json JSONB
);

-- 7. Notifications 
CREATE TABLE notifications (
    notification_id SERIAL PRIMARY KEY,
    user_id INTEGER REFERENCES users(id) ON DELETE CASCADE,
    type VARCHAR(50) NOT NULL,
    payload_json JSONB,
    read_at TIMESTAMP WITH TIME ZONE
);

